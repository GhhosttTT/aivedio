# ============================================
# AI 短剧自动化生产平台 - 环境变量配置示例
# ============================================

# 本地开发默认使用 development；Docker 镜像和 Compose 会强制使用 production。
ENVIRONMENT=development
READINESS_REQUIRE_REDIS=false

# -------------------- LLM 配置 --------------------
# Qwen2.5-14B GGUF 模型路径
LLM_MODEL_PATH=./models/qwen2.5-14b-instruct-q4_k_m.gguf
# GPU 加载的层数（剩余层 offload 到 CPU）
LLM_N_GPU_LAYERS=20
# 上下文窗口大小
LLM_N_CTX=8192
# CPU 线程数
LLM_N_THREADS=8

# -------------------- ComfyUI 配置 --------------------
# ComfyUI 服务地址
COMFYUI_BASE_URL=http://127.0.0.1:8188
# ComfyUI 工作流配置文件路径
COMFYUI_WORKFLOW_PATH=./configs/comfyui_workflow.json
# ComfyUI 图生视频 API workflow；留空时视频阶段继续使用 SVD
COMFYUI_VIDEO_WORKFLOW_PATH=
# Stable Diffusion XL 模型路径
SDXL_MODEL_PATH=./models/stable-diffusion-xl-base-1.0/sd_xl_base_1.0.safetensors
# 复杂镜头是否直接阻断；质量优先跑片建议 true，先拆镜头再生成
GENERATION_BLOCK_COMPLEX_SHOTS=true

# -------------------- SVD 配置 --------------------
# Stable Video Diffusion 模型路径
SVD_MODEL_PATH=./models/stable-video-diffusion-img2vid-xt
# 视频帧数
SVD_NUM_FRAMES=16
# 视频帧率
SVD_FPS=8
# 每个分镜生成的视频候选数；质量优先用时间换稳定性
GENERATION_VIDEO_CANDIDATES=4
# 视频候选低于门槛时追加的稳定性精修轮数
GENERATION_VIDEO_REFINEMENT_PASSES=2
# Mobile-first output: cover crops mismatched source ratios instead of adding
# black bars. Use contain only when preserving the full source canvas matters.
GENERATION_VIDEO_FRAME_FIT_MODE=cover
# 视频候选通过 llama.cpp 抽帧审核的最低平均分
GENERATION_VIDEO_MIN_SCORE=4.0
# 视频候选的短剧平台观感最低分；会重点压制塑料感、廉价滤镜、低商业质感
GENERATION_VIDEO_PLATFORM_MIN_SCORE=4.1
# 技术质量最低分；包含冻结、边界跳变、音频契约和编码质量
GENERATION_VIDEO_TECHNICAL_MIN_SCORE=3.0
# 有锁定首帧时，低于此分数的开场构图会被硬拒绝
GENERATION_VIDEO_START_FRAME_REFERENCE_MIN_SCORE=2.5
# Cross-shot character identity floor and maximum score spread.
GENERATION_CHARACTER_IDENTITY_MIN_SCORE=4.0
GENERATION_CHARACTER_IDENTITY_MAX_SCORE_SPREAD=1.5
# Repeated characters need independent review evidence in at least this many scenes.
GENERATION_CHARACTER_IDENTITY_MIN_OBSERVATIONS=2
# 连续黑帧超过此时长会阻止候选晋级；避免黑屏/编码失败片段混入成片
GENERATION_VIDEO_MAX_BLACK_SECONDS=0.2
GENERATION_VIDEO_MAX_TEMPORAL_JUMP_RATIO=0.35
# 视频抽帧平台美学子项最低分；压制光色跳变、动作卡顿、背景漂移和修复痕迹闪烁
GENERATION_VIDEO_AESTHETIC_FEATURE_MIN_SCORE=4.0
# 正式跑片建议设为 true；审核不可用或低分会阻止视频晋级
GENERATION_REQUIRE_VIDEO_REVIEW=true

# -------------------- TTS 配置 --------------------
# MiMo-V2-TTS API 密钥
TTS_API_KEY=your_mimo_api_key_here
# TTS API 基础 URL
TTS_BASE_URL=https://mimo.xiaomi.com/api/v2/tts
# Optional production voice lock: map screenplay character names to provider voice IDs.
# TTS_SPEAKER_MAP_JSON={"Alice":"voice_female_01","Bob":"voice_male_01"}
# TTS_DEFAULT_SPEAKER=voice_default

# -------------------- 数据库配置 --------------------
# 数据库连接 URL（SQLite）
DATABASE_URL=sqlite:///./short_drama.db
# 或使用 PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/short_drama

# -------------------- Redis 配置 --------------------
# Redis 连接 URL
REDIS_URL=redis://localhost:6379/0

# -------------------- Celery 配置 --------------------
# Celery Broker URL
CELERY_BROKER_URL=redis://localhost:6379/1
# Celery Result Backend URL
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# Celery Worker 并发数
CELERY_WORKER_CONCURRENCY=1

# -------------------- 文件存储配置 --------------------
# 文件存储根目录
STORAGE_PATH=./storage
# 最大存储空间（GB）
MAX_STORAGE_SIZE_GB=500

# -------------------- 安全配置 --------------------
# 加密密钥（用于加密 API 密钥等敏感信息）
ENCRYPTION_KEY=your_encryption_key_here
# JWT 密钥（请在生产环境中更改为随机字符串）
JWT_SECRET_KEY=your_jwt_secret_key_here
# JWT 算法
JWT_ALGORITHM=HS256
# JWT 访问令牌过期时间（小时）
JWT_EXPIRATION_HOURS=24
# JWT 刷新令牌过期时间（天）
JWT_REFRESH_EXPIRATION_DAYS=7

# -------------------- 性能配置 --------------------
# GPU 显存使用比例
GPU_MEMORY_FRACTION=0.95
# 是否启用 GPU 缓存清理
ENABLE_GPU_CACHE_CLEAR=true
# API 速率限制
API_RATE_LIMIT=10/minute

# -------------------- 日志配置 --------------------
# 日志级别（DEBUG, INFO, WARNING, ERROR）
LOG_LEVEL=INFO
# 日志文件路径
LOG_FILE_PATH=./logs/app.log

# -------------------- API 配置 --------------------
# API 服务地址
API_HOST=0.0.0.0
# API 服务端口
API_PORT=8000
# 是否启用热重载（开发环境）
API_RELOAD=false
# CORS 允许的源（逗号分隔，* 表示允许所有）
CORS_ORIGINS=*

# -------------------- 开发配置 --------------------
# 是否启用调试模式
DEBUG=false
# 是否启用热重载
RELOAD=false

# -------------------- Source Video Localization --------------------
LOCALIZATION_TARGET_LANGUAGES=en,es,pt,ar,id,th,vi,ja,ko
LOCALIZATION_MAX_SOURCE_VIDEO_SIZE_MB=2048
SUBTITLE_REMOVAL_BACKEND=manual_mask
OCCLUSION_REMOVAL_BACKEND=detect_only
OCCLUSION_MASK_DETECTOR_COMMAND=
OCCLUSION_AUTO_MASK_MIN_CONFIDENCE=0.65
OCCLUSION_MIN_QUALITY_SCORE=0.92
OCCLUSION_REMOVAL_TIMEOUT_SECONDS=7200
AUTO_VIDEO_INPAINT_COMMAND=
PROPINTER_COMMAND=
VSR_COMMAND=
ASR_BACKEND=faster_whisper
ASR_MODEL_PATH=./models/faster-whisper-large-v3
ASR_MODEL_SIZE=small
ASR_COMMAND=
ASR_DEVICE=cuda
ASR_COMPUTE_TYPE=float16
ASR_LANGUAGE=zh
ASR_TIMEOUT_SECONDS=7200
OCR_BACKEND=disabled
# Example after installing an OCR engine:
# OCR_BACKEND=command
# OCR_COMMAND=python scripts/ocr_subtitles.py --input {input} --output {output} --engine auto --fps 2 --crop-top 0.68 --crop-bottom 0.94
OCR_COMMAND=
OCR_MIN_CONFIDENCE=0.55
OCR_TIMEOUT_SECONDS=7200
OCR_ASR_MAX_GAP_SECONDS=0.35
TRANSLATION_BACKEND=local_llm
TRANSLATION_COMMAND=
TRANSLATION_TIMEOUT_SECONDS=7200
TRANSLATION_MAX_SEGMENTS_PER_BATCH=30
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=120
SUBTITLE_RENDER_FONT=Arial
SUBTITLE_RENDER_FONT_SIZE=38
SUBTITLE_RENDER_MARGIN_V=64
SUBTITLE_RENDER_OUTLINE=3
SUBTITLE_RENDER_SHADOW=1
SUBTITLE_RENDER_BOLD=true
SUBTITLE_RENDER_TIMEOUT_SECONDS=7200
SUBTITLE_MAX_READING_UNITS_PER_SECOND=18.0
MODERATION_BACKEND=rules
LOCALIZATION_CONCURRENCY=1

# -------------------- Generation Quality --------------------
GENERATION_PROVIDER=local_comfyui
GENERATION_PRIMARY_PROVIDER=jimeng_api
GENERATION_QUALITY_PROFILE=seed_dance_reference
ENABLE_DRAFT_MEDIA_FALLBACK=false
COMFYUI_DEFAULT_WORKFLOW_TYPE=juggernaut
COMFYUI_REFERENCE_WORKFLOW_PATH=./configs/comfyui_workflow_ipadapter_sdxl.json
# Optional regional identity control for two-character shots; validate on local hardware.
COMFYUI_MULTI_REFERENCE_WORKFLOW_PATH=
# seed_dance_reference/ultra keep searching after the first passing candidate batch.
GENERATION_MIN_QUALITY_PASSES=2
# Only tolerate small duration-rounding gaps; long frozen tails must be regenerated.
GENERATION_VIDEO_MAX_FREEZE_SECONDS=0.2
GENERATION_VIDEO_MAX_STATIC_RUN_SECONDS=1.8
# Episode-level visual consistency gates; keep these aligned with the locked style bible.
GENERATION_EPISODE_STYLE_BRIGHTNESS_WARNING=24.0
GENERATION_EPISODE_STYLE_BRIGHTNESS_BLOCKER=45.0
GENERATION_EPISODE_STYLE_SATURATION_WARNING=0.14
GENERATION_EPISODE_STYLE_SATURATION_BLOCKER=0.24
GENERATION_EPISODE_STYLE_CONTRAST_WARNING=28.0
GENERATION_EPISODE_STYLE_CONTRAST_BLOCKER=52.0
GENERATION_EPISODE_STYLE_SHARPNESS_RATIO_WARNING=2.2
GENERATION_EPISODE_STYLE_SHARPNESS_RATIO_BLOCKER=3.5
GENERATION_EPISODE_STYLE_ASPECT_RATIO_WARNING=0.08
GENERATION_EPISODE_STYLE_ASPECT_RATIO_BLOCKER=0.16
# 仅在视频 provider 返回生产级原生音频时开启；否则继续使用独立 TTS
GENERATION_PREFER_NATIVE_VIDEO_AUDIO=false
# Set this to the final save node ID when a video graph has several outputs.
COMFYUI_VIDEO_OUTPUT_NODE=
# 质量优先 profile；3060 12GB 如显存不足再降分辨率或候选数。
GENERATION_WIDTH=768
GENERATION_HEIGHT=1344
GENERATION_STEPS=28
GENERATION_CFG=6.0
GENERATION_IMAGE_CANDIDATES=5
GENERATION_IMAGE_REFINEMENT_PASSES=2
GENERATION_IMAGE_MIN_SCORE=4.0
GENERATION_IMAGE_PLATFORM_MIN_SCORE=4.1
GENERATION_IMAGE_AESTHETIC_FEATURE_MIN_SCORE=4.0
# Rhythm and opening-hook gates used by production readiness and audit hashing.
GENERATION_RHYTHM_MIN_SHOT_SECONDS=1.2
GENERATION_RHYTHM_MAX_SILENT_SHOT_SECONDS=6.0
GENERATION_RHYTHM_MAX_DIALOGUE_MARGIN_SECONDS=0.30
GENERATION_RHYTHM_SAME_ROLE_WARNING_RUN=3
GENERATION_RHYTHM_MAX_HOOK_LATENCY_SECONDS=8.0
GENERATION_TURNAROUND_FEATURE_MIN_SCORE=4.0
GENERATION_REQUIRE_IMAGE_REVIEW=true
# 入选关键帧后的本地精修命令，可接 FaceDetailer/CodeFormer/GFPGAN/upscale/ComfyUI 二段工作流
# 占位符：{input} {output} {prompt} {negative_prompt} {reference}
GENERATION_IMAGE_POSTPROCESS_COMMAND=
GENERATION_REQUIRE_IMAGE_POSTPROCESS=false
GENERATION_IMAGE_POSTPROCESS_TIMEOUT_SECONDS=1800
GENERATION_QUALITY_PROMPT_APPEND="clean cinematic composition, coherent anatomy, readable main action, balanced lighting, polished short-drama keyframe"
GENERATION_QUALITY_NEGATIVE_APPEND="amateur snapshot, dull composition, muddy lighting, deformed face, deformed hands, broken fingers, extra people, random text, logo, watermark, bad crop, messy background"
LOCAL_REVIEW_BACKEND=llama_cpp
LOCAL_REVIEW_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_REVIEW_MODEL=local-vlm
LOCAL_REVIEW_TIMEOUT=300
LOCAL_REVIEW_PROBE_TIMEOUT=2
JIMENG_ENDPOINT=
JIMENG_API_KEY=
KLING_ENDPOINT=
KLING_API_KEY=
HAILUO_ENDPOINT=
HAILUO_API_KEY=

# Generic production video gateway. Set GENERATION_PROVIDER=http_video_api
# or GENERATION_PROVIDER=hybrid + GENERATION_PRIMARY_PROVIDER=http_video_api.
# The gateway receives JSON with prompt, negative_prompt, legacy reference_image,
# multimodal references, optional audio/continuation, shot_plan, and generation
# controls. References are labelled Image1/Video1/Audio1 for prompt binding.
# It may return video_url/video_base64 synchronously, or job_id with a status endpoint.
HTTP_VIDEO_ENDPOINT=
HTTP_VIDEO_API_KEY=
HTTP_VIDEO_STATUS_ENDPOINT=
HTTP_VIDEO_RESULT_ENDPOINT=
HTTP_VIDEO_TIMEOUT_SECONDS=1800
HTTP_VIDEO_POLL_INTERVAL_SECONDS=5
HTTP_VIDEO_MAX_POLLS=240
HTTP_VIDEO_MAX_RETRIES=2
HTTP_VIDEO_RETRY_BACKOFF_SECONDS=1.0
HTTP_VIDEO_IDEMPOTENCY_ENABLED=true
HTTP_VIDEO_IDEMPOTENCY_KEY_HEADER=Idempotency-Key
HTTP_VIDEO_AUTH_HEADER=Authorization
HTTP_VIDEO_AUTH_SCHEME=Bearer
HTTP_VIDEO_NATIVE_AUDIO=false
HTTP_VIDEO_MULTI_SHOT=false
HTTP_VIDEO_VALIDATE_OUTPUT=true
HTTP_VIDEO_MAX_REFERENCE_IMAGES=9
HTTP_VIDEO_MAX_REFERENCE_VIDEOS=3
HTTP_VIDEO_MAX_REFERENCE_AUDIOS=3

# Explicit Seedance reference-to-video gateway. Set GENERATION_PROVIDER=seedance_api.
# API access and model availability depend on the selected hosted gateway.
SEEDANCE_ENDPOINT=
SEEDANCE_API_KEY=
SEEDANCE_STATUS_ENDPOINT=
SEEDANCE_RESULT_ENDPOINT=
SEEDANCE_MODEL=doubao-seedance-2-5-260628
# Leave empty for automatic official-Ark detection; use legacy for a generic
# compatible gateway or ark_v3 to force the native Volcano Ark contract.
SEEDANCE_API_FORMAT=
# Required by ark_v3 when local video/audio references must be exposed to Ark.
# Must include {filename} or {path}; example: https://cdn.example.com/aivideo/{filename}
SEEDANCE_MEDIA_URL_TEMPLATE=
# reference_to_video（严格兼容网关）、multi_shot，或原生 Ark 2.5 的 auto
SEEDANCE_REQUEST_MODE=reference_to_video
SEEDANCE_MULTI_SHOT_DURATION_SECONDS=30
SEEDANCE_RESOLUTION=1080p
SEEDANCE_TIMEOUT_SECONDS=1800
SEEDANCE_POLL_INTERVAL_SECONDS=5
SEEDANCE_MAX_POLLS=240
SEEDANCE_CALLBACK_URL=
SEEDANCE_CALLBACK_SECRET=
# Local-only escape hatch; keep false in production.
SEEDANCE_CALLBACK_ALLOW_UNSIGNED=false
SEEDANCE_MAX_RETRIES=2
SEEDANCE_RETRY_BACKOFF_SECONDS=1.0
SEEDANCE_IDEMPOTENCY_ENABLED=true
SEEDANCE_IDEMPOTENCY_KEY_HEADER=Idempotency-Key
SEEDANCE_AUTH_HEADER=Authorization
SEEDANCE_AUTH_SCHEME=Bearer
SEEDANCE_BITRATE_MODE=high
SEEDANCE_CODEC=H264
SEEDANCE_INCLUDE_EXPERIMENTAL_FIELDS=false
SEEDANCE_NATIVE_AUDIO=true
SEEDANCE_MULTI_SHOT=true
# true only for an explicit single 30-second sequence request; false avoids
# generating a 30-second clip for every atomic scene in a project.
SEEDANCE_SEQUENCE_LEVEL_MULTI_SHOT=false
SEEDANCE_RETURN_LAST_FRAME=true
SEEDANCE_CAMERA_FIXED=false
SEEDANCE_WATERMARK=false
SEEDANCE_OUTPUT_FORMAT=mp4
SEEDANCE_VALIDATE_OUTPUT=true
SEEDANCE_DRAFT=false
# Seedance 2.0 defaults. Seedance 2.5 gateways may allow 30/10/10.
SEEDANCE_MAX_REFERENCE_IMAGES=9
SEEDANCE_MAX_REFERENCE_VIDEOS=3
SEEDANCE_MAX_REFERENCE_AUDIOS=3
