{
  "workflow": {
    "name": "Juggernaut XL v9 + FaceDetailer - Eye Fix",
    "description": "使用 Juggernaut XL v9 + FaceDetailer 修复眼睛细节",
    "version": "1.0.0"
  },
  "nodes": {
    "checkpoint_loader": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": {
        "ckpt_name": "Juggernaut-XL_v9_RunDiffusionPhoto_v2.safetensors"
      }
    },
    "clip_text_encode_positive": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "",
        "clip": ["checkpoint_loader", 1]
      }
    },
    "clip_text_encode_negative": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "",
        "clip": ["checkpoint_loader", 1]
      }
    },
    "empty_latent_image": {
      "class_type": "EmptyLatentImage",
      "inputs": {
        "width": 1344,
        "height": 768,
        "batch_size": 1
      }
    },
    "ksampler": {
      "class_type": "KSampler",
      "inputs": {
        "seed": 0,
        "steps": 30,
        "cfg": 5.2,
        "sampler_name": "dpmpp_2m_sde",
        "scheduler": "karras",
        "denoise": 1.0,
        "model": ["checkpoint_loader", 0],
        "positive": ["clip_text_encode_positive", 0],
        "negative": ["clip_text_encode_negative", 0],
        "latent_image": ["empty_latent_image", 0]
      }
    },
    "vae_decode": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": ["ksampler", 0],
        "vae": ["checkpoint_loader", 2]
      }
    },
    "clipseg_detector": {
      "class_type": "CLIPSegDetectorProvider",
      "inputs": {
        "text": "face, eyes",
        "blur": 7,
        "threshold": 0.4,
        "dilation_factor": 4
      }
    },
    "sam_loader": {
      "class_type": "SAMLoader",
      "inputs": {
        "model_name": "sam_vit_b_01ec64.pth",
        "device_mode": "AUTO"
      }
    },
    "facedetailer": {
      "class_type": "FaceDetailer",
      "inputs": {
        "image": ["vae_decode", 0],
        "model": ["checkpoint_loader", 0],
        "clip": ["checkpoint_loader", 1],
        "vae": ["checkpoint_loader", 2],
        "guide_size": 768,
        "guide_size_for": true,
        "max_size": 1024,
        "seed": 0,
        "steps": 22,
        "cfg": 5.0,
        "sampler_name": "dpmpp_2m_sde",
        "scheduler": "karras",
        "positive": ["clip_text_encode_positive", 0],
        "negative": ["clip_text_encode_negative", 0],
        "denoise": 0.24,
        "feather": 5,
        "noise_mask": true,
        "force_inpaint": true,
        "bbox_threshold": 0.5,
        "bbox_dilation": 10,
        "bbox_crop_factor": 3.0,
        "sam_detection_hint": "center-1",
        "sam_dilation": 0,
        "sam_threshold": 0.93,
        "sam_bbox_expansion": 0,
        "sam_mask_hint_threshold": 0.7,
        "sam_mask_hint_use_negative": "False",
        "drop_size": 10,
        "bbox_detector": ["clipseg_detector", 0],
        "sam_model_opt": ["sam_loader", 0],
        "wildcard": "",
        "cycle": 1
      }
    },
    "save_image": {
      "class_type": "SaveImage",
      "inputs": {
        "filename_prefix": "juggernaut_facedetailer",
        "images": ["facedetailer", 0]
      }
    }
  }
}
