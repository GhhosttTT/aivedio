{
  "workflow": {
    "name": "SDXL 12GB production keyframe pipeline",
    "version": "1.0.0",
    "description": "Two-stage latent generation followed by separate face and hand repair passes. Runs serially for 12GB GPUs."
  },
  "nodes": {
    "checkpoint_loader": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": {"ckpt_name": "Juggernaut-XL_v9_RunDiffusionPhoto_v2.safetensors"}
    },
    "positive": {
      "class_type": "CLIPTextEncode",
      "inputs": {"text": "", "clip": ["checkpoint_loader", 1]}
    },
    "negative": {
      "class_type": "CLIPTextEncode",
      "inputs": {"text": "", "clip": ["checkpoint_loader", 1]}
    },
    "latent": {
      "class_type": "EmptyLatentImage",
      "inputs": {"width": 768, "height": 1344, "batch_size": 1}
    },
    "composition_sampler": {
      "class_type": "KSampler",
      "inputs": {
        "seed": 0, "steps": 40, "cfg": 5.2,
        "sampler_name": "dpmpp_2m_sde", "scheduler": "karras", "denoise": 1.0,
        "model": ["checkpoint_loader", 0], "positive": ["positive", 0],
        "negative": ["negative", 0], "latent_image": ["latent", 0]
      }
    },
    "latent_upscale": {
      "class_type": "LatentUpscaleBy",
      "inputs": {"samples": ["composition_sampler", 0], "upscale_method": "bislerp", "scale_by": 1.35}
    },
    "detail_sampler": {
      "class_type": "KSampler",
      "inputs": {
        "seed": 1, "steps": 20, "cfg": 4.8,
        "sampler_name": "dpmpp_2m_sde", "scheduler": "karras", "denoise": 0.22,
        "model": ["checkpoint_loader", 0], "positive": ["positive", 0],
        "negative": ["negative", 0], "latent_image": ["latent_upscale", 0]
      }
    },
    "decode_detail": {
      "class_type": "VAEDecode",
      "inputs": {"samples": ["detail_sampler", 0], "vae": ["checkpoint_loader", 2]}
    },
    "face_detector": {
      "class_type": "CLIPSegDetectorProvider",
      "inputs": {"text": "face, eyes", "blur": 7, "threshold": 0.4, "dilation_factor": 4}
    },
    "hand_detector": {
      "class_type": "CLIPSegDetectorProvider",
      "inputs": {"text": "hands, fingers", "blur": 5, "threshold": 0.38, "dilation_factor": 3}
    },
    "sam_loader": {
      "class_type": "SAMLoader",
      "inputs": {"model_name": "sam_vit_b_01ec64.pth", "device_mode": "AUTO"}
    },
    "face_detailer": {
      "class_type": "FaceDetailer",
      "inputs": {
        "image": ["decode_detail", 0], "model": ["checkpoint_loader", 0],
        "clip": ["checkpoint_loader", 1], "vae": ["checkpoint_loader", 2],
        "guide_size": 768, "guide_size_for": true, "max_size": 1024,
        "seed": 2, "steps": 22, "cfg": 5.0, "sampler_name": "dpmpp_2m_sde",
        "scheduler": "karras", "positive": ["positive", 0], "negative": ["negative", 0],
        "denoise": 0.2, "feather": 5, "noise_mask": true, "force_inpaint": true,
        "bbox_threshold": 0.5, "bbox_dilation": 10, "bbox_crop_factor": 3.0,
        "sam_detection_hint": "center-1", "sam_dilation": 0, "sam_threshold": 0.93,
        "sam_bbox_expansion": 0, "sam_mask_hint_threshold": 0.7,
        "sam_mask_hint_use_negative": "False", "drop_size": 10,
        "bbox_detector": ["face_detector", 0], "sam_model_opt": ["sam_loader", 0],
        "wildcard": "", "cycle": 1
      }
    },
    "hand_detailer": {
      "class_type": "FaceDetailer",
      "inputs": {
        "image": ["face_detailer", 0], "model": ["checkpoint_loader", 0],
        "clip": ["checkpoint_loader", 1], "vae": ["checkpoint_loader", 2],
        "guide_size": 640, "guide_size_for": true, "max_size": 896,
        "seed": 3, "steps": 16, "cfg": 4.6, "sampler_name": "dpmpp_2m_sde",
        "scheduler": "karras", "positive": ["positive", 0], "negative": ["negative", 0],
        "denoise": 0.14, "feather": 6, "noise_mask": true, "force_inpaint": true,
        "bbox_threshold": 0.45, "bbox_dilation": 8, "bbox_crop_factor": 2.5,
        "sam_detection_hint": "center-1", "sam_dilation": 0, "sam_threshold": 0.9,
        "sam_bbox_expansion": 0, "sam_mask_hint_threshold": 0.65,
        "sam_mask_hint_use_negative": "False", "drop_size": 12,
        "bbox_detector": ["hand_detector", 0], "sam_model_opt": ["sam_loader", 0],
        "wildcard": "", "cycle": 1
      }
    },
    "save_final": {
      "class_type": "SaveImage",
      "inputs": {"images": ["hand_detailer", 0], "filename_prefix": "short_drama_production_12gb"}
    }
  },
  "parameters": {
    "default": {"width": 768, "height": 1344, "steps": 40, "cfg_scale": 5.2, "output_node": "save_final"}
  },
  "negative_prompt": {
    "default": "text, watermark, duplicate people, malformed hands, extra fingers, extra limbs, plastic skin, blurry, wax face, bad eyes, bad anatomy"
  }
}
